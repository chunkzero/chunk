# Settings for compose.yaml. Copy this file to .env and fill in the secrets and the engine socket. Keep .env for the
# life of the install: CHUNK_SECRET_KEY encrypts stored secrets, so a new key loses them.
#
# Without openssl, `head -c 32 /dev/urandom | base64` makes the key, and
# `head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'` makes 64 hex digits for the tokens and the password.

# 32 random bytes, base64-encoded: `openssl rand -base64 32`
CHUNK_SECRET_KEY=
# Your token for the dashboard and the API: at least 32 characters, for example `echo "chunk_$(openssl rand -hex 32)"`.
CHUNK_OPERATOR_TOKEN=
# The token the edge calls management with, generated the same way.
CHUNK_EDGE_TOKEN=
# Postgres's password: `openssl rand -hex 24`
POSTGRES_PASSWORD=

# The engine socket management starts machines through, and a group ID that may use it inside management.
# Docker: /var/run/docker.sock, and the group from `stat -c %g /var/run/docker.sock`.
# Rootless Podman: run `systemctl --user enable --now podman.socket`, then use ${XDG_RUNTIME_DIR}/podman/podman.sock
# and group 0. Compose fills in XDG_RUNTIME_DIR from the shell it runs in; if that shell lacks it, write the full path,
# /run/user/<your user ID>/podman/podman.sock.
CHUNK_ENGINE_SOCKET=/var/run/docker.sock
CHUNK_ENGINE_GID=

# Optional settings, shown with their defaults.

# The host port players connect to, and the host IPv4 address it is published on.
# CHUNK_PLAYER_PORT=25565
# CHUNK_PLAYER_BIND=0.0.0.0
# Environments get the hostname env-<24 hex digits>.<domain>; point *.<domain> at this host.
# CHUNK_EDGE_DOMAIN=localhost
# Where the host publishes management's API and dashboard, and the URL clients reach them at, which login and upload
# links use. Change them together.
# CHUNK_MANAGEMENT_PUBLISH=127.0.0.1:8080
# CHUNK_PUBLIC_URL=http://localhost:8080
# The images. {java} stands for a release's Java version.
# CHUNK_ENVIRONMENT_IMAGE=chunk-environment:0.1.0
# CHUNK_JVM_IMAGE=chunk-jvm:{java}
# CHUNK_EDGE_IMAGE=chunk-edge:0.1.0
# CHUNK_MANAGEMENT_IMAGE=chunk-management:0.1.0
