{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "sortImports": true,
  "proseWrap": "always",
  "ignorePatterns": [
    "**/AGENTS.md",
    "**/CLAUDE.md",
    "LICENSE.md",
    "pnpm-lock.yaml",
    "Cargo.lock",
    "crates/chunk-protocol/data/**"
  ]
}
